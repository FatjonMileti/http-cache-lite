{
  "name": "http-cache-lite",
  "version": "2.0.0",
  "description": "Lightweight, framework-friendly HTTP response caching for Node.js/TypeScript with TTL, LRU, tags, ETag, Cache-Control, SWR and request deduplication.",
  "keywords": [
    "http",
    "cache",
    "lru",
    "ttl",
    "etag",
    "cache-control",
    "express",
    "middleware",
    "stale-while-revalidate",
    "deduplication"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:FatjonMileti/http-cache-lite.git"
  },
  "homepage": "https://github.com/FatjonMileti/http-cache-lite#readme",
  "bugs": {
    "url": "https://github.com/FatjonMileti/http-cache-lite/issues"
  },
  "license": "MIT",
  "author": "Fatjon Mileti",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": {
        "import": "./dist/middleware.d.ts",
        "require": "./dist/middleware.d.cts",
        "default": "./dist/middleware.d.ts"
      },
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    },
    "./storage": {
      "types": {
        "import": "./dist/storage/index.d.ts",
        "require": "./dist/storage/index.d.cts",
        "default": "./dist/storage/index.d.ts"
      },
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples benchmarks --max-warnings 0",
    "lint:fix": "eslint src tests examples benchmarks --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"benchmarks/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"benchmarks/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx benchmarks/bench.ts",
    "prepack": "npm run build",
    "example": "tsx examples/express/app.ts"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "express": "^4.21.0",
    "supertest": "^7.0.0"
  },
  "sideEffects": false,
  "directories": {
    "example": "examples",
    "test": "tests"
  }
}
